# macOS
.DS_Store

# lean-spec review evidence (local audit aid — review.md citations are the durable record)
features/*/evidence/

# backups & scratch
*.bak
tmp/

# crash-leftover atomic-write temp files (tmp + os.replace never completed)
features/*/.workflow*
.lean-spec/.auto*

# vendored test harness — bootstrapped by scripts/bootstrap-bats.sh
.tools/

# python bytecode (e.g. from `py_compile bin/lean-spec`)
__pycache__/
*.pyc
