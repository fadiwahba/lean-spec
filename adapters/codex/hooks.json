{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(apply_patch|Bash)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'root=$(git rev-parse --show-toplevel) || exit 1; exec \"$root/.lean-spec/runtime/hooks/pre-tool-use-guard.sh\"'"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'root=$(git rev-parse --show-toplevel) || exit 1; exec \"$root/.lean-spec/runtime/hooks/subagent-stop-gate.sh\"'"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'root=$(git rev-parse --show-toplevel) || exit 1; exec \"$root/.lean-spec/runtime/hooks/subagent-start-bind.sh\"'"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'root=$(git rev-parse --show-toplevel) || exit 1; exec \"$root/.lean-spec/runtime/hooks/stop-auto-driver.sh\"'"
          }
        ]
      }
    ]
  }
}
