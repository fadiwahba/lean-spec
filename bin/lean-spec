#!/usr/bin/env python3
"""lean-spec state CLI — the only writer of workflow state.

Layer rule (see docs/CONSTITUTION.md): skills describe, hooks enforce, this
CLI mutates. Nothing outside this file may write workflow.json.

Subcommands:
    ensure <slug>                  create .lean-spec/features/<slug>/workflow.json if absent
    advance <slug> <from> <to>     atomic phase transition (tmp + os.replace)
    assert <slug> <phase>          exit 2 if current phase != <phase>
    validate <slug> <artifact>     rules.toml-driven artifact checks
    next <slug>|--all [--json]     phase -> next-skill resolver
    status [<slug>] [--json]       read-only report
    auto arm <slug> [flags]        arm the Stop-hook auto driver (.lean-spec/auto.json)
    auto disarm                    remove .lean-spec/auto.json
    auto status [--json]           read-only auto-mode report
    migrate-layout [--dry-run]     move legacy docs/ and features/ below .lean-spec/

Exit codes:
    0   success
    1   usage / environment error (bad args, missing python floor, not a
        git repo, missing files that should have been created by `ensure`)
    2   gate failure (illegal transition, assert mismatch, validate failure,
        close attempted without APPROVE)
    3   `next` has no actionable skill (BLOCKED verdict, missing verdict) —
        distinct from 0 (closed: nothing to do) so drivers can stop looping.

Token approximation: artifact "tokens" are approximated as whitespace-split
word count (len(text.split())). This is a conservative proxy chosen for
determinism without a tokenizer dependency (stdlib only) — it is not exact
LLM-token accounting, just a cheap cap to catch runaway artifacts.
"""
import fcntl
import hashlib
import json
import os
import re
import subprocess
import sys
import tempfile
import uuid
from contextlib import contextmanager
from datetime import datetime, timezone

PROG = "lean-spec"

# ---------------------------------------------------------------------------
# Preflight (CONSTITUTION principle 8: fail loudly, one-line actionable msg)
# ---------------------------------------------------------------------------

def fail(msg, code=1):
    sys.stderr.write(f"{PROG}: {msg}\n")
    sys.exit(code)


def check_python_version():
    if sys.version_info < (3, 11):
        v = f"{sys.version_info.major}.{sys.version_info.minor}.{sys.version_info.micro}"
        fail(f"python3 >= 3.11 required (found {v}) — install a newer python3 and retry", 1)


def find_git_root():
    try:
        out = subprocess.run(
            ["git", "rev-parse", "--show-toplevel"],
            capture_output=True, text=True, timeout=10,
        )
    except FileNotFoundError:
        fail("git not found on PATH — install git and retry", 1)
    if out.returncode != 0:
        fail("not inside a git repo — run lean-spec from within your project's git repository", 1)
    return out.stdout.strip()


# ---------------------------------------------------------------------------
# Small helpers
# ---------------------------------------------------------------------------

def now_iso():
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


SLUG_RE = re.compile(r"^[a-z0-9][a-z0-9._-]*$")


def validate_slug(slug):
    """CONSTITUTION principle 8 (fail loudly): reject any slug that is not
    a plain path segment before it ever reaches os.path.join, so a
    malicious/careless slug (path traversal like '../evil', an absolute
    path like '/tmp/x', or an empty string) can never escape features/."""
    if not SLUG_RE.match(slug):
        fail(
            f"invalid slug '{slug}' — slugs must match ^[a-z0-9][a-z0-9._-]*$ "
            "(lowercase alphanumeric, '.', '_', '-'; no path separators)",
            1,
        )


def artifact_root(root):
    return os.path.join(root, ".lean-spec")


def project_doc_path(root, artifact):
    return os.path.join(artifact_root(root), artifact)


def feature_dir(root, slug):
    return os.path.join(artifact_root(root), "features", slug)


def workflow_path(root, slug):
    return os.path.join(feature_dir(root, slug), "workflow.json")


def atomic_write_json(path, data, tmp_prefix=".workflowXXXXXX"):
    """tmp file (same dir, X-suffix per portability convention) + os.replace.

    mkstemp creates the tmp file 0600, and os.replace makes the target
    inherit that mode — so without restoring it, every write would silently
    downgrade an existing file to owner-only. Preserve an existing file's
    mode; for a new file, honor the process umask (as a normal create would)
    rather than leaving it 0600.

    `tmp_prefix` selects the crash-leftover pattern .gitignore already covers
    (`.lean-spec/features/*/.workflow*` for workflow.json, `.lean-spec/.auto*` for
    auto.json) — a mismatched prefix would leave an interrupted write visible
    in `git status`.
    """
    d = os.path.dirname(path)
    os.makedirs(d, exist_ok=True)
    try:
        mode = os.stat(path).st_mode & 0o777
    except FileNotFoundError:
        umask = os.umask(0)
        os.umask(umask)
        mode = 0o666 & ~umask
    fd, tmp_path = tempfile.mkstemp(prefix=tmp_prefix, dir=d)
    try:
        with os.fdopen(fd, "w") as f:
            json.dump(data, f, indent=2, sort_keys=True)
            f.write("\n")
        os.chmod(tmp_path, mode)
        os.replace(tmp_path, path)
    except BaseException:
        try:
            os.unlink(tmp_path)
        except OSError:
            pass
        raise


@contextmanager
def feature_lock(root, slug):
    """Advisory exclusive lock serializing a feature's read-modify-write.
    The lockfile matches the gitignored `.lean-spec/features/*/.workflow*` pattern, so
    it never shows up in git status. fcntl.flock is POSIX (macOS + Linux)."""
    d = feature_dir(root, slug)
    os.makedirs(d, exist_ok=True)
    lock_path = os.path.join(d, ".workflow.lock")
    fd = os.open(lock_path, os.O_CREAT | os.O_RDWR, 0o600)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX)
        yield
    finally:
        os.close(fd)


def load_workflow(root, slug, required=True):
    path = workflow_path(root, slug)
    if not os.path.isfile(path):
        if required:
            fail(f"no such feature '{slug}' (missing {path}) — run `lean-spec ensure {slug}` first", 1)
        return None
    try:
        with open(path) as f:
            data = json.load(f)
    except json.JSONDecodeError as e:
        fail(f"corrupt workflow.json for '{slug}': {e}", 1)
    if not isinstance(data, dict):
        fail(f"corrupt workflow.json for '{slug}': not a JSON object", 1)
    if "history" in data and not isinstance(data["history"], list):
        fail(f"corrupt workflow.json for '{slug}': history is not a list", 1)
    return data


VALID_PHASES = ("specifying", "implementing", "reviewing", "closed")
ALLOWED_TRANSITIONS = {
    ("specifying", "implementing"),
    ("implementing", "reviewing"),
    ("reviewing", "implementing"),
    ("reviewing", "closed"),
}


# ---------------------------------------------------------------------------
# ensure
# ---------------------------------------------------------------------------

def cmd_ensure(root, args):
    if len(args) != 1:
        fail("usage: lean-spec ensure <slug>", 1)
    slug = args[0]
    validate_slug(slug)
    path = workflow_path(root, slug)
    if os.path.isfile(path):
        return 0  # idempotent no-op
    ts = now_iso()
    data = {
        "phase": "specifying",
        "history": [],
        "created_at": ts,
        "updated_at": ts,
    }
    atomic_write_json(path, data)
    return 0


# ---------------------------------------------------------------------------
# advance
# ---------------------------------------------------------------------------

def _gate_close_requires_verdict(root, slug):
    """CONSTITUTION quality bar: close requires verdict == required_verdict
    (default APPROVE); no manual override path exists. Enforced here (the
    CLI), never as skill prose logic."""
    rules = load_rules(root)
    required = rules["defaults"].get("required_verdict", "APPROVE")
    review_path = os.path.join(feature_dir(root, slug), "review.md")
    if not os.path.isfile(review_path):
        fail(f"cannot close '{slug}': review.md not found — run /lean-spec:review first", 2)
    with open(review_path) as f:
        verdict = extract_verdict(f.read())
    if verdict != required:
        fail(f"cannot close '{slug}': review.md verdict is '{verdict}', required '{required}'", 2)


def _gate_fix_requires_needs_fixes(root, slug):
    """The fix loop (reviewing -> implementing) is only legitimate when the
    reviewer returned NEEDS_FIXES: APPROVE routes to close, BLOCKED stops the
    line and escalates, and a missing/invalid verdict is not an actionable
    fix. Enforced here so the state machine matches resolve_next's routing
    rather than trusting the caller to only send back genuine fix cycles."""
    review_path = os.path.join(feature_dir(root, slug), "review.md")
    if not os.path.isfile(review_path):
        fail(f"cannot send '{slug}' back to implementing: review.md not found — run /lean-spec:review first", 2)
    with open(review_path) as f:
        verdict = extract_verdict(f.read())
    if verdict != "NEEDS_FIXES":
        fail(f"cannot send '{slug}' back to implementing: review.md verdict is '{verdict}', expected 'NEEDS_FIXES'", 2)


SOURCE_PHASE_ARTIFACT = {"specifying": "spec.md", "implementing": "notes.md"}


def _gate_source_artifact(root, slug, frm):
    """CONSTITUTION principle 4: an invalid artifact blocks the advance.
    Validates the artifact belonging to the phase being left (spec.md when
    leaving specifying, notes.md when leaving implementing) before the
    transition is committed. reviewing->closed has its own, stricter verdict
    gate (_gate_close_requires_verdict); reviewing->implementing has the
    verdict gate _gate_fix_requires_needs_fixes."""
    artifact = SOURCE_PHASE_ARTIFACT.get(frm)
    if artifact is None:
        return
    rules = load_rules(root)
    errors = validate_artifact(root, slug, artifact, rules)
    if errors:
        fail(
            f"cannot advance '{slug}' out of '{frm}': " + "; ".join(errors),
            2,
        )


def cmd_advance(root, args):
    # --no-tdd / --tdd record a per-feature TDD override in workflow.json so
    # the notes.md gate honors a spike opt-out instead of only reading the
    # global rules.toml default (which the model cannot vary per feature).
    tdd_override = None
    positional = []
    for a in args:
        if a == "--no-tdd":
            tdd_override = False
        elif a == "--tdd":
            tdd_override = True
        else:
            positional.append(a)
    if len(positional) != 3:
        fail("usage: lean-spec advance <slug> <from> <to> [--tdd|--no-tdd]", 1)
    slug, frm, to = positional
    validate_slug(slug)
    for p in (frm, to):
        if p not in VALID_PHASES:
            fail(f"unknown phase '{p}' — valid phases: {', '.join(VALID_PHASES)}", 1)
    # Fail fast on a missing feature before feature_lock's makedirs creates a
    # (lockfile-only) directory for a slug that was never `ensure`d. The real
    # check still runs inside the lock below; this only avoids the litter.
    if not os.path.isfile(workflow_path(root, slug)):
        load_workflow(root, slug)  # raises the friendly "no such feature" fail
    # Serialize the whole load -> gate -> mutate -> write against concurrent
    # advances on the same slug, so two racing callers cannot both read the
    # stale phase, both pass the `current != frm` check, and clobber each
    # other's history entry.
    with feature_lock(root, slug):
        wf = load_workflow(root, slug)
        current = wf.get("phase")
        if current != frm:
            fail(f"'{slug}' is in phase '{current}', not '{frm}' — cannot advance from '{frm}'", 2)
        if (frm, to) not in ALLOWED_TRANSITIONS:
            fail(f"illegal transition '{frm}' -> '{to}' for '{slug}'", 2)
        _gate_source_artifact(root, slug, frm)
        if (frm, to) == ("reviewing", "closed"):
            _gate_close_requires_verdict(root, slug)
        if (frm, to) == ("reviewing", "implementing"):
            _gate_fix_requires_needs_fixes(root, slug)
        ts = now_iso()
        wf["phase"] = to
        wf["updated_at"] = ts
        if tdd_override is not None:
            wf["tdd"] = tdd_override
        wf.setdefault("history", []).append({"from": frm, "to": to, "at": ts})
        path = workflow_path(root, slug)
        atomic_write_json(path, wf)
        # post-advance assertion (defensive: re-read from disk)
        reread = load_workflow(root, slug)
        if reread.get("phase") != to:
            fail(f"post-advance assertion failed for '{slug}': expected phase '{to}', found '{reread.get('phase')}'", 2)
    return 0


# ---------------------------------------------------------------------------
# assert
# ---------------------------------------------------------------------------

def cmd_assert(root, args):
    if len(args) != 2:
        fail("usage: lean-spec assert <slug> <phase>", 1)
    slug, phase = args
    validate_slug(slug)
    wf = load_workflow(root, slug)
    current = wf.get("phase")
    if current != phase:
        fail(f"assert failed: '{slug}' phase is '{current}', expected '{phase}'", 2)
    return 0


# ---------------------------------------------------------------------------
# rules.toml loading (additive: absent file/keys enforce nothing)
# ---------------------------------------------------------------------------

DEFAULT_RULES = {
    "defaults": {"tdd": True, "required_verdict": "APPROVE"},
    "agents": {},
    "required_sections": {},
    "max_tokens": {},
}


def load_rules(root):
    import tomllib
    path = os.path.join(root, ".lean-spec", "rules.toml")
    rules = {
        "defaults": dict(DEFAULT_RULES["defaults"]),
        "agents": {},
        "required_sections": {},
        "max_tokens": {},
    }
    if not os.path.isfile(path):
        return rules
    try:
        with open(path, "rb") as f:
            data = tomllib.load(f)
    except tomllib.TOMLDecodeError as e:
        fail(f"invalid .lean-spec/rules.toml: {e}", 1)

    # The top-level [defaults]/[required_sections]/[max_tokens] keys must be
    # tables. A wrong-typed container (e.g. `required_sections = "foo"`) would
    # otherwise blow up the .update() below with a raw traceback — validate
    # the container shape before the value shapes (CONSTITUTION principle 8).
    for key in ("defaults", "agents", "required_sections", "max_tokens"):
        if key in data and not isinstance(data[key], dict):
            fail(
                f"invalid .lean-spec/rules.toml: [{key}] must be a table "
                f"(found {data[key]!r})",
                1,
            )
    rules["defaults"].update(data.get("defaults", {}))
    rules["agents"].update(data.get("agents", {}))
    rules["required_sections"].update(data.get("required_sections", {}))
    rules["max_tokens"].update(data.get("max_tokens", {}))

    # CONSTITUTION principle 8 (fail loudly): a malformed rules.toml value
    # must never reach the comparison/iteration code as a crash-inducing
    # traceback — validate shapes here, once, at load time.
    for key, cap in rules["max_tokens"].items():
        if isinstance(cap, bool) or not isinstance(cap, int):
            fail(
                f"invalid .lean-spec/rules.toml: max_tokens.\"{key}\" must be "
                f"an integer (found {cap!r})",
                1,
            )
    for key, sections in rules["required_sections"].items():
        if not isinstance(sections, list) or not all(
            isinstance(s, str) for s in sections
        ):
            fail(
                f"invalid .lean-spec/rules.toml: required_sections.\"{key}\" "
                f"must be a list of strings (found {sections!r})",
                1,
            )
    tdd = rules["defaults"].get("tdd", True)
    if not isinstance(tdd, bool):
        fail(
            f"invalid .lean-spec/rules.toml: [defaults].tdd must be true or "
            f"false (found {tdd!r})",
            1,
        )
    verdict = rules["defaults"].get("required_verdict", "APPROVE")
    if verdict not in ("APPROVE", "NEEDS_FIXES", "BLOCKED"):
        fail(
            f"invalid .lean-spec/rules.toml: [defaults].required_verdict must "
            f"be one of APPROVE/NEEDS_FIXES/BLOCKED (found {verdict!r})",
            1,
        )
    return rules


def cmd_provider(root, args):
    if len(args) < 3 or args[0] not in ("argv", "run"):
        fail("usage: lean-spec provider argv|run <owner> --prompt <text>", 1)
    action, owner = args[:2]
    if args[2:3] != ["--prompt"] or len(args) != 4:
        fail("usage: lean-spec provider argv|run <owner> --prompt <text>", 1)
    config = load_rules(root)["agents"].get(owner)
    if not isinstance(config, dict):
        fail(f"provider configuration missing for owner '{owner}' in [agents]", 1)
    provider = config.get("provider")
    model = config.get("model")
    effort = config.get("effort")
    if not isinstance(provider, str):
        fail(f"provider configuration for '{owner}' requires provider", 1)
    if effort is not None and not isinstance(effort, str):
        fail(f"provider configuration for '{owner}' has invalid effort", 1)
    try:
        module_dir = os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "adapters")
        if module_dir not in sys.path:
            sys.path.insert(0, module_dir)
        from providers import build_argv, require_executable
        argv = build_argv(provider, model, effort, args[3])
        require_executable(argv)
    except ValueError as error:
        fail(str(error), 1)
    if action == "argv":
        print(json.dumps({"schema_version": 1, "owner": owner, "provider": provider, "argv": argv}))
        return 0
    completed = subprocess.run(argv, cwd=root, capture_output=True, text=True)
    if completed.returncode != 0:
        message = completed.stderr.strip() or completed.stdout.strip() or "provider command failed"
        fail(f"provider '{provider}' failed: {message}", 2)
    print(completed.stdout, end="")
    return 0


VERDICT_RE = re.compile(r"^verdict:\s*(APPROVE|NEEDS_FIXES|BLOCKED)\b", re.IGNORECASE)


def extract_verdict(text):
    for line in text.splitlines():
        m = VERDICT_RE.match(line.strip())
        if m:
            return m.group(1).upper()
    return None


def approx_tokens(text):
    return len(text.split())


HTML_COMMENT_RE = re.compile(r"<!--.*?-->", re.DOTALL)


def _section_bodies(text):
    """Map '## heading' -> raw body text beneath it (up to the next '## ').
    Used only for project-doc placeholder detection."""
    bodies, current, buf = {}, None, []
    for line in text.splitlines():
        if line.startswith("## "):
            if current is not None:
                bodies[current] = "\n".join(buf)
            current, buf = line[3:].strip(), []
        elif current is not None:
            buf.append(line)
    if current is not None:
        bodies[current] = "\n".join(buf)
    return bodies


def _is_unfilled(body):
    """True when a section is empty once the template HTML-comment
    placeholder and whitespace are stripped."""
    return HTML_COMMENT_RE.sub("", body).strip() == ""


# Built-in baseline sections for the two project-level docs
# (.lean-spec/PRD.md, .lean-spec/CONSTITUTION.md), matching templates. These are
# not part of the per-feature rules.toml surface documented in PRD §7 (which
# only covers spec.md/notes.md/review.md); the plan skill still needs a CLI
# check (layer rule: no gate logic in skill prompts), so this baseline
# applies unconditionally for --project validation and rules.toml may only
# extend it (never required to define it — zero-config still works).
PROJECT_DOC_SECTIONS = {
    "PRD.md": ["Problem & Users", "Features", "Constraints", "Quality Bar", "Non-Goals"],
    "CONSTITUTION.md": ["Stack", "Principles", "Delegation", "Quality Bars", "Process", "Non-Goals"],
}

READINESS_SECTIONS = (
    (
        "Existing System & Behaviour",
        "What existing product behaviour, users, data, APIs, or integrations must remain unchanged?",
        "The feature workflow cannot decide compatibility requirements without an explicit preservation boundary.",
    ),
    (
        "Compatibility & Migration",
        "What compatibility limits or migration requirements apply, or should the project record that none are needed?",
        "An unattended run must not guess whether existing users, data, or clients need a migration path.",
    ),
    (
        "Regression Checks",
        "Which regression checks and verification command must pass before a feature can close?",
        "The project needs an explicit regression check before unattended implementation can start.",
    ),
)


def emit_outcome(result, as_json):
    """Emit the host-neutral, versioned workflow result contract."""
    if as_json:
        print(json.dumps(result, indent=2, sort_keys=True))
        return
    outcome = result["outcome"]
    if outcome == "NEEDS_INPUT":
        print(f"{outcome}: {result['question']}")
    elif outcome == "READY":
        print(f"{outcome}: {result['step']}")
    else:
        print(outcome)


def project_readiness(root):
    prd_path = project_doc_path(root, "PRD.md")
    if not os.path.isfile(prd_path):
        return READINESS_SECTIONS[0]
    with open(prd_path, encoding="utf-8") as f:
        bodies = _section_bodies(f.read())
    for requirement in READINESS_SECTIONS:
        section = requirement[0]
        if section not in bodies or _is_unfilled(bodies[section]):
            return requirement
    return None


def cmd_readiness(root, args):
    as_json = "--json" in args
    args = [arg for arg in args if arg != "--json"]
    if args not in ([], ["--no-confirm"]):
        fail("usage: lean-spec readiness [--no-confirm] [--json]", 1)

    missing = project_readiness(root)
    if missing is not None:
        _, question, reason = missing
        emit_outcome({
            "schema_version": 1,
            "outcome": "NEEDS_INPUT",
            "input_scope": "project",
            "slug": None,
            "question": question,
            "reason": reason,
            "resume_step": "plan",
        }, as_json)
        return 0
    emit_outcome({
        "schema_version": 1,
        "outcome": "READY",
        "step": "spec",
        "slug": None,
        "owner": "architect",
        "artifact": "spec.md",
        "gate": "project-readiness-valid",
    }, as_json)
    return 0


def validate_artifact(root, slug, artifact, rules, project=False):
    """Returns list of error strings; empty list means valid."""
    errors = []
    if project:
        path = project_doc_path(root, artifact)
    else:
        path = os.path.join(feature_dir(root, slug), artifact)
    if not os.path.isfile(path):
        return [f"{artifact} not found at {path}"]
    with open(path) as f:
        text = f.read()

    headings = {
        line[3:].strip()
        for line in text.splitlines()
        if line.startswith("## ")
    }

    if project:
        required = list(PROJECT_DOC_SECTIONS.get(artifact, []))
        for extra in rules["required_sections"].get(artifact, []):
            if extra not in required:
                required.append(extra)
    else:
        required = list(rules["required_sections"].get(artifact, []))
        if artifact == "notes.md":
            # Per-feature workflow.json `tdd` (set by advance --tdd/--no-tdd)
            # overrides the global rules.toml default, so a documented spike
            # opt-out actually satisfies this same gate.
            tdd_required = rules["defaults"].get("tdd", True)
            wf = load_workflow(root, slug, required=False)
            if isinstance(wf, dict) and isinstance(wf.get("tdd"), bool):
                tdd_required = wf["tdd"]
            if tdd_required and "TDD" not in required:
                required.append("TDD")

    missing = [s for s in required if s not in headings]
    if missing:
        errors.append(f"{artifact} missing required section(s): {', '.join(missing)}")

    if project:
        bodies = _section_bodies(text)
        unfilled = [
            s for s in required
            if s in headings and _is_unfilled(bodies.get(s, ""))
        ]
        if unfilled:
            errors.append(
                f"{artifact} has unfilled placeholder section(s): "
                f"{', '.join(unfilled)} — run /lean-spec:plan to fill them"
            )

    cap = rules["max_tokens"].get(artifact)
    if cap is not None:
        n = approx_tokens(text)
        if n > cap:
            errors.append(f"{artifact} exceeds max_tokens cap: {n} > {cap} (approx. word count)")

    if artifact == "review.md":
        verdict = extract_verdict(text)
        if verdict is None:
            errors.append("review.md missing a 'verdict: APPROVE|NEEDS_FIXES|BLOCKED' line")

    return errors


def cmd_validate(root, args):
    if len(args) == 2 and args[0] == "--project":
        artifact = args[1]
        rules = load_rules(root)
        errors = validate_artifact(root, None, artifact, rules, project=True)
        label = f".lean-spec/{artifact}"
    elif len(args) == 2:
        slug, artifact = args
        validate_slug(slug)
        rules = load_rules(root)
        errors = validate_artifact(root, slug, artifact, rules)
        label = f"{slug}/{artifact}"
    else:
        fail("usage: lean-spec validate <slug> <artifact> | validate --project <artifact>", 1)
    if errors:
        for e in errors:
            sys.stderr.write(f"{PROG}: validate: {e}\n")
        return 2
    print(f"{PROG}: validate: {label} OK")
    return 0


