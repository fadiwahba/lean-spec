# next
# ---------------------------------------------------------------------------

def resolve_next(root, slug):
    """Returns dict: {slug, phase, action, skill, reason}."""
    wf = load_workflow(root, slug)
    phase = wf.get("phase")
    result = {"slug": slug, "phase": phase, "action": None, "skill": None, "reason": None}
    if phase == "specifying":
        result["action"] = "skill"
        result["skill"] = "/lean-spec:implement"
    elif phase == "implementing":
        result["action"] = "skill"
        result["skill"] = "/lean-spec:review"
    elif phase == "reviewing":
        review_path = os.path.join(feature_dir(root, slug), "review.md")
        if not os.path.isfile(review_path):
            result["action"] = "blocked"
            result["reason"] = "review.md not found"
        else:
            with open(review_path) as f:
                verdict = extract_verdict(f.read())
            if verdict == "APPROVE":
                result["action"] = "skill"
                result["skill"] = "/lean-spec:close"
            elif verdict == "NEEDS_FIXES":
                result["action"] = "skill"
                result["skill"] = "/lean-spec:fix"
            elif verdict == "BLOCKED":
                result["action"] = "blocked"
                result["reason"] = "review.md verdict is BLOCKED — escalate"
            else:
                result["action"] = "blocked"
                result["reason"] = "review.md missing a valid verdict line"
    elif phase == "closed":
        result["action"] = "closed"
    else:
        result["action"] = "blocked"
        result["reason"] = f"unknown phase '{phase}'"
    return result


def format_next_text(r):
    if r["action"] == "skill":
        return f"{r['skill']} {r['slug']}"
    if r["action"] == "closed":
        return f"{r['slug']}: closed — nothing to do"
    return f"{r['slug']}: blocked — {r['reason']}"


def list_feature_slugs(root):
    features_root = os.path.join(artifact_root(root), "features")
    if not os.path.isdir(features_root):
        return []
    slugs = []
    for name in sorted(os.listdir(features_root)):
        if os.path.isfile(os.path.join(features_root, name, "workflow.json")):
            slugs.append(name)
    return slugs


def cmd_next(root, args):
    as_json = "--json" in args
    args = [a for a in args if a != "--json"]
    if len(args) != 1:
        fail("usage: lean-spec next <slug>|--all [--json]", 1)
    target = args[0]
    if target == "--all":
        slugs = list_feature_slugs(root)
        results = [resolve_next(root, s) for s in slugs]
        if as_json:
            print(json.dumps(results, indent=2, sort_keys=True))
        else:
            if not results:
                print("no features found")
            for r in results:
                print(format_next_text(r))
        # --all is a report; never fails the invocation on individual blocks
        return 0
    validate_slug(target)
    r = resolve_next(root, target)
    if as_json:
        print(json.dumps(r, indent=2, sort_keys=True))
    else:
        print(format_next_text(r))
    if r["action"] == "blocked":
        return 3
    return 0


# ---------------------------------------------------------------------------
# auto (arm / disarm / status) — the only writer of .lean-spec/auto.json
# ---------------------------------------------------------------------------
# auto.json is a state file with a designated writer, exactly like
# workflow.json: once it exists, hooks/stop-auto-driver.sh drives phases whose
# skills are all `disable-model-invocation: true`. Giving it a CLI writer is
# what lets hooks/pre-tool-use-guard.sh deny Write/Edit on it outright without
# breaking /lean-spec:auto — removing the discretion rather than policing it
# (CONSTITUTION principle 1: skills describe, hooks enforce, the CLI mutates).

AUTO_DIR = ".lean-spec"
AUTO_FILE = "auto.json"
DEFAULT_MAX_CYCLES = 20
DEFAULT_MAX_FEATURES = 20


def auto_path(root):
    return os.path.join(root, AUTO_DIR, AUTO_FILE)


@contextmanager
def auto_lock(root):
    directory = artifact_root(root)
    os.makedirs(directory, exist_ok=True)
    fd = os.open(os.path.join(directory, ".auto.lock"), os.O_CREAT | os.O_RDWR, 0o600)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX)
        yield
    finally:
        os.close(fd)


def load_auto(root):
    """Returns the parsed auto.json, or None when disarmed. Fails loudly on a
    corrupt/non-object file rather than silently treating it as disarmed."""
    path = auto_path(root)
    if not os.path.isfile(path):
        return None
    try:
        with open(path) as f:
            data = json.load(f)
    except json.JSONDecodeError as e:
        fail(f"corrupt {AUTO_DIR}/{AUTO_FILE}: {e} — run `lean-spec auto disarm` to reset", 1)
    if not isinstance(data, dict):
        fail(f"corrupt {AUTO_DIR}/{AUTO_FILE}: not a JSON object — run `lean-spec auto disarm` to reset", 1)
    return data


def auto_run_id(data):
    run_id = data.get("run_id")
    if isinstance(run_id, str) and run_id:
        return run_id
    legacy = json.dumps(data, sort_keys=True, separators=(",", ":"))
    return "legacy-" + hashlib.sha256(legacy.encode()).hexdigest()[:24]


def _parse_positive_int(raw, flag):
    try:
        value = int(raw)
    except ValueError:
        fail(f"{flag} must be an integer (found '{raw}')", 1)
    if value < 1:
        fail(f"{flag} must be >= 1 (found {value})", 1)
    return value


def _auto_int(data, key, default, minimum=0):
    value = data.get(key, default)
    if isinstance(value, bool):
        fail(f"auto tick rejected: {key} must be an integer", 1)
    try:
        value = int(value)
    except (TypeError, ValueError):
        fail(f"auto tick rejected: {key} must be an integer", 1)
    if value < minimum:
        fail(f"auto tick rejected: {key} must be >= {minimum}", 1)
    data[key] = value
    return value


def cmd_auto_arm(root, args):
    slug = None
    gates_on = False
    chain_all = False
    no_confirm = False
    max_cycles = DEFAULT_MAX_CYCLES
    max_features = DEFAULT_MAX_FEATURES
    for a in args:
        if a == "--gates-on":
            gates_on = True
        elif a == "--chain-all":
            chain_all = True
        elif a == "--no-confirm":
            no_confirm = True
        elif a.startswith("--max-cycles="):
            max_cycles = _parse_positive_int(a.split("=", 1)[1], "--max-cycles")
        elif a.startswith("--max-features="):
            max_features = _parse_positive_int(a.split("=", 1)[1], "--max-features")
        elif a.startswith("-"):
            fail(
                f"unknown flag '{a}' — usage: lean-spec auto arm <slug> "
                "[--gates-on] [--chain-all] [--no-confirm] [--max-cycles=N] [--max-features=N]",
                1,
            )
        elif slug is None:
            slug = a
        else:
            fail(f"unexpected argument '{a}' — usage: lean-spec auto arm <slug> [flags]", 1)

    if slug is None:
        fail("usage: lean-spec auto arm <slug> [--gates-on] [--chain-all] [--no-confirm] [--max-cycles=N] [--max-features=N]", 1)
    validate_slug(slug)
    # Refuse to arm a feature that does not exist: the driver would resolve no
    # step on its first poke and disarm anyway, so failing here is the loud
    # version of the same outcome (principle 8).
    load_workflow(root, slug)

    # `--no-confirm` is only meaningful while chaining (it governs what happens
    # once no non-closed feature remains) — accepting it alone would write a
    # key the driver never reads.
    if no_confirm and not chain_all:
        fail("--no-confirm requires --chain-all (it only governs the end of a chain)", 1)

    data = {
        "schema_version": 1,
        "run_id": str(uuid.uuid4()),
        "slug": slug,
        "expected_phase": load_workflow(root, slug)["phase"],
        "status": "armed",
        "gates_on": gates_on,
        "max_cycles": max_cycles,
        "cycles": 0,
        # Provenance: an audit trail of when this run was armed and by which
        # writer. NOTE (issue #21): this is a record, NOT an authorization
        # proof — `auto arm` is a Bash invocation, so it cannot distinguish a
        # human-invoked /lean-spec:auto from a model running it unprompted.
        # See docs/CONSTITUTION.md "Known gap".
        "armed_by": "command",
        "armed_at": now_iso(),
    }
    if chain_all:
        data["chain_all"] = True
        if no_confirm:
            data["no_confirm"] = True
            data["max_features"] = max_features
            data["features_specced"] = 0
    atomic_write_json(auto_path(root), data, tmp_prefix=".autoXXXXXX")
    return 0


def _auto_result(outcome, data, **extra):
    result = {
        "schema_version": 1,
        "outcome": outcome,
        "slug": data["slug"],
        "expected_phase": data["expected_phase"],
    }
    result.update(extra)
    return result


def _write_auto_result(root, data, event_id, result):
    data["last_event_id"] = event_id
    data["last_result"] = result
    atomic_write_json(auto_path(root), data, tmp_prefix=".autoXXXXXX")
    print(json.dumps(result, indent=2, sort_keys=True))


def _next_non_closed_slug(root):
    for candidate in list_feature_slugs(root):
        if load_workflow(root, candidate).get("phase") != "closed":
            return candidate
    return None


def cmd_auto_tick(root, args):
    run_id = event_id = None
    as_json = False
    index = 0
    while index < len(args):
        arg = args[index]
        if arg == "--json":
            as_json = True
        elif arg in ("--run-id", "--event-id"):
            if index + 1 >= len(args):
                fail(f"{arg} requires a value", 1)
            value = args[index + 1]
            if arg == "--run-id":
                run_id = value
            else:
                event_id = value
            index += 1
        else:
            fail("usage: lean-spec auto tick --run-id <id> --event-id <id> [--json]", 1)
        index += 1
    if not run_id or not event_id:
        fail("usage: lean-spec auto tick --run-id <id> --event-id <id> [--json]", 1)

    with auto_lock(root):
        data = load_auto(root)
        if data is None:
            fail("auto run is disarmed", 2)
        if auto_run_id(data) != run_id:
            fail("auto tick rejected: run id does not match the armed run", 2)
        if data.get("last_event_id") == event_id:
            result = data.get("last_result")
            if not isinstance(result, dict):
                fail("auto tick rejected: duplicate event has no stored result", 1)
            print(json.dumps(result, indent=2, sort_keys=True))
            return 0

        slug = data.get("slug")
        if not isinstance(slug, str):
            fail("auto tick rejected: armed run is missing slug", 1)
        workflow = load_workflow(root, slug)
        expected_phase = data.get("expected_phase", workflow.get("phase"))
        if not isinstance(expected_phase, str):
            fail("auto tick rejected: armed run has an invalid expected phase", 1)
        if workflow.get("phase") != expected_phase:
            fail(
                f"auto tick rejected: expected phase '{expected_phase}', found '{workflow.get('phase')}'",
                2,
            )
        data.setdefault("schema_version", 1)
        data.setdefault("run_id", run_id)
        data.setdefault("expected_phase", expected_phase)
        data.setdefault("status", "armed")

        if data.get("no_confirm"):
            missing = project_readiness(root)
            if missing is not None:
                _, question, reason = missing
                result = {
                    "schema_version": 1,
                    "outcome": "NEEDS_INPUT",
                    "input_scope": "project",
                    "slug": slug,
                    "question": question,
                    "reason": reason,
                    "resume_step": "plan",
                }
                data["status"] = "needs_input"
                data["pending_input"] = result
                _write_auto_result(root, data, event_id, result)
                return 0
            if data.get("status") == "needs_input":
                data["status"] = "armed"
                data.pop("pending_input", None)
        cycles = _auto_int(data, "cycles", 0)
        max_cycles = _auto_int(data, "max_cycles", DEFAULT_MAX_CYCLES, 1)

        next_state = resolve_next(root, slug)
        action = next_state["action"]
        if action == "skill":
            if cycles >= max_cycles:
                data["status"] = "blocked"
                result = _auto_result("BLOCKED", data, reason="maximum auto cycles reached")
            else:
                data["cycles"] = cycles + 1
                result = _auto_result(
                    "READY", data,
                    next_step=next_state["skill"].rsplit(":", 1)[-1],
                    skill=next_state["skill"],
                )
        elif action == "blocked":
            data["status"] = "blocked"
            result = _auto_result("BLOCKED", data, reason=next_state["reason"])
        elif action == "closed":
            if data.get("chain_all"):
                next_slug = _next_non_closed_slug(root)
                if next_slug is not None:
                    next_workflow = load_workflow(root, next_slug)
                    data["slug"] = next_slug
                    data["expected_phase"] = next_workflow["phase"]
                    data["cycles"] = 0
                    next_state = resolve_next(root, next_slug)
                    if next_state["action"] == "skill":
                        result = _auto_result(
                            "READY", data,
                            next_step=next_state["skill"].rsplit(":", 1)[-1],
                            skill=next_state["skill"],
                        )
                    else:
                        data["status"] = "blocked"
                        result = _auto_result("BLOCKED", data, reason="next chained feature is not actionable")
                elif data.get("no_confirm"):
                    features_specced = _auto_int(data, "features_specced", 0)
                    max_features = _auto_int(data, "max_features", DEFAULT_MAX_FEATURES, 1)
                    if features_specced >= max_features:
                        data["status"] = "complete"
                        result = _auto_result("COMPLETE", data)
                    else:
                        data["features_specced"] = features_specced + 1
                        result = _auto_result("READY", data, next_step="spec")
                else:
                    data["status"] = "complete"
                    result = _auto_result("COMPLETE", data)
            else:
                data["status"] = "complete"
                result = _auto_result("COMPLETE", data)
        else:
            fail("auto tick rejected: unknown next-step action", 1)
        _write_auto_result(root, data, event_id, result)
    return 0


def cmd_auto_disarm(root, args):
    if args:
        fail("usage: lean-spec auto disarm", 1)
    try:
        os.remove(auto_path(root))
    except FileNotFoundError:
        pass  # idempotent: disarming when nothing is armed is a no-op (principle 6)
    return 0


def cmd_auto_status(root, args):
    as_json = "--json" in args
    args = [a for a in args if a != "--json"]
    if args:
        fail("usage: lean-spec auto status [--json]", 1)
    data = load_auto(root)
    if data is None:
        if as_json:
            print(json.dumps({"armed": False}, indent=2, sort_keys=True))
        else:
            print(f"{PROG}: auto: disarmed")
        return 0
    info = dict(data)
    info["run_id"] = auto_run_id(data)
    info["armed"] = True
    if as_json:
        print(json.dumps(info, indent=2, sort_keys=True))
    else:
        for k in sorted(info):
            print(f"{k}: {info[k]}")
    return 0


AUTO_SUBCOMMANDS = {
    "arm": cmd_auto_arm,
    "disarm": cmd_auto_disarm,
    "status": cmd_auto_status,
    "tick": cmd_auto_tick,
}


def cmd_auto(root, args):
    usage = f"usage: lean-spec auto <{'|'.join(AUTO_SUBCOMMANDS)}> ..."
    if not args:
        fail(usage, 1)
    sub, rest = args[0], args[1:]
    if sub not in AUTO_SUBCOMMANDS:
        fail(f"unknown auto subcommand '{sub}' — {usage}", 1)
    return AUTO_SUBCOMMANDS[sub](root, rest)


# ---------------------------------------------------------------------------
# layout migration
# ---------------------------------------------------------------------------

def _legacy_layout_moves(root):
    return [
        (os.path.join(root, "docs", "PRD.md"), project_doc_path(root, "PRD.md")),
        (os.path.join(root, "docs", "CONSTITUTION.md"), project_doc_path(root, "CONSTITUTION.md")),
        (os.path.join(root, "features"), os.path.join(artifact_root(root), "features")),
    ]


def cmd_migrate_layout(root, args):
    dry_run = args == ["--dry-run"]
    if args and not dry_run:
        fail("usage: lean-spec migrate-layout [--dry-run]", 1)

    moves = [(source, destination) for source, destination in _legacy_layout_moves(root) if os.path.exists(source)]
    conflicts = [
        (source, destination)
        for source, destination in moves
        if os.path.exists(destination)
    ]
    if conflicts:
        source, destination = conflicts[0]
        fail(
            f"layout migration conflict: both {os.path.relpath(source, root)} and "
            f"{os.path.relpath(destination, root)} exist — resolve the conflict before retrying",
            1,
        )
    if not moves:
        print(f"{PROG}: layout already canonical")
        return 0

    for source, destination in moves:
        print(f"{os.path.relpath(source, root)} -> {os.path.relpath(destination, root)}")
    if dry_run:
        return 0

    for source, destination in moves:
        os.makedirs(os.path.dirname(destination), exist_ok=True)
        os.replace(source, destination)
    return 0


# ---------------------------------------------------------------------------
# status
# ---------------------------------------------------------------------------

def feature_status(root, slug):
    wf = load_workflow(root, slug)
    info = {
        "slug": slug,
        "phase": wf.get("phase"),
        "created_at": wf.get("created_at"),
        "updated_at": wf.get("updated_at"),
        "history_len": len(wf.get("history", [])),
    }
    if wf.get("phase") == "reviewing":
        review_path = os.path.join(feature_dir(root, slug), "review.md")
        if os.path.isfile(review_path):
            with open(review_path) as f:
                info["verdict"] = extract_verdict(f.read())
        else:
            info["verdict"] = None
    return info


def cmd_status(root, args):
    as_json = "--json" in args
    args = [a for a in args if a != "--json"]
    if len(args) > 1:
        fail("usage: lean-spec status [<slug>] [--json]", 1)
    if args:
        validate_slug(args[0])
        info = feature_status(root, args[0])
        if as_json:
            print(json.dumps(info, indent=2, sort_keys=True))
        else:
            for k, v in info.items():
                print(f"{k}: {v}")
        return 0
    slugs = list_feature_slugs(root)
    infos = [feature_status(root, s) for s in slugs]
    if as_json:
        print(json.dumps(infos, indent=2, sort_keys=True))
    else:
        if not infos:
            print("no features found")
        for info in infos:
            print(f"{info['slug']}: {info['phase']} (updated {info['updated_at']})")
    return 0


# ---------------------------------------------------------------------------
# main
# ---------------------------------------------------------------------------

COMMANDS = {
    "ensure": cmd_ensure,
    "advance": cmd_advance,
    "assert": cmd_assert,
    "validate": cmd_validate,
    "next": cmd_next,
    "status": cmd_status,
    "auto": cmd_auto,
    "provider": cmd_provider,
    "readiness": cmd_readiness,
    "migrate-layout": cmd_migrate_layout,
}


def main(argv):
    check_python_version()
    if not argv:
        fail(f"usage: lean-spec <{'|'.join(COMMANDS)}> ...", 1)
    cmd, rest = argv[0], argv[1:]
    if cmd in ("-h", "--help"):
        print(f"usage: lean-spec <{'|'.join(COMMANDS)}> ...")
        return 0
    if cmd not in COMMANDS:
        fail(f"unknown command '{cmd}' — usage: lean-spec <{'|'.join(COMMANDS)}> ...", 1)
    root = find_git_root()
    return COMMANDS[cmd](root, rest)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
